# 复制为 .env 后，将示例路径替换为本机实际路径。
# 安装根目录包含 .venv/、model/ 和 model-source.json。
QWEN_TTS_HOME="C:/path/to/qwen3-tts"

# 可选：覆盖安装根目录推导的 Python 和模型路径。
# QWEN_TTS_PYTHON="C:/path/to/qwen3-tts/.venv/Scripts/python.exe"
# QWEN_TTS_MODEL_DIR="C:/path/to/qwen3-tts/model"

# 可选：已在 PATH 中配置音频工具时可省略。
QWEN_TTS_FFMPEG="C:/path/to/ffmpeg/bin/ffmpeg.exe"
QWEN_TTS_FFPROBE="C:/path/to/ffmpeg/bin/ffprobe.exe"

{
  "globs": ["**/*.md"],
  "gitignore": true,
  "ignores": [
    "CLAUDE.md",
    "skills/*/scripts/**",
    "skills-internal/*/scripts/**",
    ".agents/skills/*/scripts/**",
  ],
  "fix": true,
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD007": { "indent": 2 },
    "MD025": { "front_matter_title": "" },
    "MD024": false,
    "MD033": false,
    "MD036": false,
    "no-hard-tabs": false,
    "whitespace": false,
    "MD013": false,
    "MD060": false,
  },
}

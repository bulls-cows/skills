{
  "name": "yy-read-pdf-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npm run format && npm run lint:code && npm run lint:markdown && npm run typecheck && npm run test",
    "format": "node scripts/run-python.mjs -m ruff format .",
    "lint:code": "node scripts/run-python.mjs -m ruff check . --fix",
    "lint:markdown": "markdownlint-cli2",
    "typecheck": "node scripts/run-python.mjs -m pyright .",
    "test": "node scripts/run-python.mjs -m unittest discover -s tests",
    "ready": "npm install && node scripts/run-python.mjs -m pip install -e \".[dev]\""
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.22.1"
  }
}

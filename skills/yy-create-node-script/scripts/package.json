{
  "name": "node-script-template",
  "version": "1.0.0",
  "description": "脱敏的 Node.js TypeScript 脚本模板项目",
  "main": "src/main.ts",
  "type": "module",
  "imports": {
    "#constants/*": "./src/constants/*.ts",
    "#steps/*": "./src/steps/*.ts",
    "#typings/*": "./src/typings/*.ts",
    "#utils/*": "./src/utils/*.ts",
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "start": "node ./src/main.ts",
    "start:example": "cross-env INPUT_FILE=./resources/input.json OUTPUT_FILE=./resources/output.json npm run start",
    "test": "node --test test/**/*.test.ts",
    "lint": "node --run format && node --run eslint && node --run typecheck",
    "eslint": "eslint . --fix",
    "format": "prettier . --write",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "cross-env": "10.1.0",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1"
  }
}

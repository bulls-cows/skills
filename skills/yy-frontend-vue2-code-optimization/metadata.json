{
  "name": "yy-frontend-vue2-code-optimization",
  "version": "1.1.0",
  "date": "April 2026",
  "author": "wengdongyang",
  "category": "code-quality",
  "framework": "vue2",
  "languages": ["vue", "javascript", "css", "scss", "less"],
  "abstract": "针对 Vue2 项目的代码优化技能。支持 .vue/.js/.css/.scss/.less 文件，包含代码风格清洗、BEM 样式规范、语义化命名、注释增强、异步优化。风险分级执行，零风险自动执行，中/高风险需用户确认，绝不修改业务逻辑。",
  "risk_levels": ["zero-risk", "low-risk", "medium-risk", "high-risk"],
  "features": [
    "code-style-formatting",
    "import-sorting",
    "bem-naming",
    "semantic-naming",
    "jsdoc-comments",
    "async-await-transform",
    "computed-first",
    "business-logic-analysis"
  ],
  "compatibility": {
    "vue": "2.x",
    "vue3": "use yy-frontend-vue3-code-optimization"
  }
}
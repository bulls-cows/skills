{
  "name": "yy-wechat-to-markdown-scripts",
  "private": true,
  "type": "module",
  "main": "src/cli.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "npm run format && npm run lint:eslint && npm run lint:markdown && npm run lint:type && npm run test",
    "lint:prettier": "prettier --check \"src/**/*.ts\"",
    "lint:eslint": "eslint \"src/**/*.ts\"",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#dist\" --fix",
    "lint:type": "tsc --noEmit",
    "test": "node --test tests/**/*.test.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "ready": "npm install"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.7.0",
    "eslint": "^9.0.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}

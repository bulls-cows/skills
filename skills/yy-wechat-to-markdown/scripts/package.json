{
  "name": "yy-wechat-to-markdown-scripts",
  "private": true,
  "type": "module",
  "main": "src/cli.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "npm run lint:prettier && npm run lint:eslint && npm run lint:type",
    "lint:prettier": "prettier --check \"src/**/*.ts\"",
    "lint:eslint": "eslint \"src/**/*.ts\"",
    "lint:type": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.7.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}

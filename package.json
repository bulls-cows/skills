{
  "name": "open-skills",
  "version": "1.0.0",
  "description": "本仓库维护了一些实用的规则和 AI 技能。",
  "main": "README.md",
  "type": "module",
  "imports": {
    "#scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "ready": "npm install && node ./scripts/install-skills-deps.ts",
    "lint": "node --run lint:prettier && node --run check:skill && node --run lint:skills && node --run lint:markdown && node --run check:type && node --run lint:lf && node --run sync:marketplace && node --run lint:eslint",
    "lint:eslint": "eslint scripts/ --fix",
    "lint:prettier": "prettier --write .",
    "lint:skills": "node ./scripts/lint-skills.ts",
    "check:skill": "node ./scripts/check-skill.ts",
    "lint:markdown": "markdownlint-cli2",
    "lint:lf": "node ./scripts/convert-crlf-to-lf.ts --check",
    "check:type": "tsc --noEmit",
    "sync:marketplace": "node ./scripts/sync-marketplace.ts",
    "install:skills": "node ./scripts/install-skills.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bulls-cows/skills.git"
  },
  "keywords": [
    "open-skills",
    "ai",
    "skills",
    "bulls-cows",
    "bulls-cows/skills"
  ],
  "author": "bulls-cows",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/bulls-cows/skills/issues"
  },
  "homepage": "https://github.com/bulls-cows/skills#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.19.15",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "js-yaml": "4.1.1",
    "markdownlint-cli2": "0.22.1",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "dependencies": {
    "front-matter": "4.0.2",
    "marked": "18.0.0",
    "minimatch": "10.2.5"
  }
}
